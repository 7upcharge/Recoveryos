RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_test_webhook_secret
DATABASE_PATH=./recoveryos.db
FLASK_ENV=development

# ── Risk Detection Thresholds (Day 2) ────────────────────────────────────────
# Maximum seconds between payment.failed and payment.authorized before R1 fires.
DELAYED_AUTH_THRESHOLD_SECONDS=90
# Rolling window width (minutes) for counting repeated failures in R3.
REPEATED_FAILURE_WINDOW_MINUTES=10
# Minimum payment.failed events within the sliding window for R3 to fire.
REPEATED_FAILURE_COUNT=3
# Minimum distinct payment attempts for R4 to consider intent signal.
MIN_ATTEMPTS_FOR_INTENT=2

# ── Gemini Diagnoser Configuration (Day 3) ──────────────────────────────────
# Gemini API key obtained from Google AI Studio.
GEMINI_API_KEY=your_gemini_api_key_here
# Gemini model name used for diagnosis.
GEMINI_MODEL=gemini-2.5-flash
# Timeout in seconds for Gemini API requests.
GEMINI_TIMEOUT_SECONDS=10

# ── Development Webhook Tunnel (Test Mode) ──────────────────────────────────
# Public base URL provided by ngrok or Cloudflare Tunnel (e.g. https://xxxx.ngrok-free.app).
# Full Webhook URL will be: ${PUBLIC_WEBHOOK_BASE_URL}/webhooks/razorpay
PUBLIC_WEBHOOK_BASE_URL=https://your-tunnel-subdomain.ngrok-free.app

